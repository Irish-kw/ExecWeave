            [2557, 2625,
             '設定，不會自動安裝或改寫。請在使用者自己的環境明確執行 `execweave hooks install antigravity`（也支援 '
             '`claude`、`codex`、`cursor`、`opencode`），不要使用 sudo。`execweave hooks status antigravity` 只讀取設定。'],
            [2633, 2719,
             ' 本身仍可能要求授權；**完成設定不等於已送出證據**。缺少證據與觀測不完整會獨立於行程退出結果記錄。\n'
             '\n'
             '[觀測完整度與失敗示例](docs/observation-integrity.md) 說明行程結果、獨立任務驗證、觀測完整度三個軸，以及尚未解除的發布阻擋項目。這批修改尚未發布，PyPI 0.8.34 '
             '不包含這些修改']]},
 {'path': 'src/execweave/agent_bootstrap.py',
  'before_sha256': '3f6ddfd1a695b27f6d807e616048d15608272bab0e0a22abac37f8b3d6d0dab0',
  'after_sha256': 'fa3fd6642b1ae098c51782e9463aac78c428c243a5dc929dd73f44a554210410',
  'edits': [[195, 195, '\nfrom .hook_command import hook_argv, hook_command, hook_markers\n'],
            [1991, 2008, 'any(value in command for value in hook_markers(marker))'],
            [2256, 2256,
             '\n'
             '\n'
             'def _migrate_hook_commands(value: object, marker: str) -> bool:\n'
             '    """Upgrade only our old canonical bare entry point, retaining user settings."""\n'
             '    changed = False\n'
             '    if isinstance(value, dict):\n'
             '        command = value.get("command")\n'
             '        if isinstance(command, str):\n'
             '            prefix = f"{marker} --auto"\n'
             '            suffix = command[len(prefix):] if command.startswith(prefix) else None\n'
             '            valid_suffixes = {"", " --event PreInvocation", " --event PostInvocation",\n'
             '                              " --event PostToolUse", " --event Stop"}\n'
             '            if suffix in valid_suffixes:\n'
             '                provider = marker.removeprefix("execweave-").removesuffix("-hook")\n'
             '                value["command"] = hook_command(provider) + suffix\n'
             '                changed = True\n'
             '        for child in value.values():\n'
             '            changed = _migrate_hook_commands(child, marker) or changed\n'
             '    elif isinstance(value, list):\n'
             '        for child in value:\n'
             '            changed = _migrate_hook_commands(child, marker) or changed\n'
             '    return changed\n'],
            [2446, 2451, '_migrate_hook_commands(merged, marker)'],
            [4068, 4068, '    changed = _migrate_hook_commands(merged, marker)\n'],
            [4143, 4148, 'changed'],
            [7007, 7029, ''],
            [7072, 7072,
             'from .opencode_plugin_cli import plugin_text\n'
             '            if existing != plugin_text(("execweave-opencode-hook", _AUTO_FLAG)):\n'
             '                '],
            [8510, 8547, 'hook_command("claude")'],
            [8690, 8726, 'hook_command("codex")'],
            [9044, 9081, 'hook_command("cursor")'],
            [10027, 10065, 'tuple(hook_argv("opencode")'],
            [11035, 11041, 'configured_unverified'],
            [11147, 11168, 'configured; delivery unverifi'],
            [11481, 11481,
             '\n'
             '\n'
             'def inspect_supported_agent(\n'
             '    command: list[str], *, home: str | Path | None = None,\n'
             '    environment: Mapping[str, str] | None = None,\n'
             ') -> AgentBootstrapResult:\n'
             '    """Read configuration only. Configuration is never proof of hook delivery."""\n'
             '    provider = supported_agent(command)\n'
             '    if provider is None:\n'
             '        return AgentBootstrapResult(provider=None, status="unavailable",\n'
             '                                    detail="no specialized lifecycle integration")\n'
             '    env = os.environ if environment is None else environment\n'
             '    home_path = Path.home() if home is None else Path(home).expanduser()\n'
             '    target = _provider_target(provider, home=home_path, environment=env)\n'
             '    try:\n'
             '        raw = _read_bytes(target)\n'
             '        if raw is None:\n'
             '            return AgentBootstrapResult(provider=provider, status="not_configured", path=str(target),\n'
             '                                        detail=f"Run execweave hooks install {provider} explicitly; never use sudo")\n'
             '        if provider == "opencode":\n'
             '            present = any(marker in raw.decode("utf-8")\n'
             '                          for marker in hook_markers("execweave-opencode-hook"))\n'
             '        else:\n'
             '            config = _load_json_object(raw, path=target)\n'
             '            present = _contains_execweave_command(config, f"execweave-{provider}-hook")\n'
             '            if provider == "claude" and config.get("disableAllHooks") is True:\n'
             '                present = False\n'
             '            if provider == "antigravity":\n'
             '                group = config.get("execweave-observability", {})\n'
             '                present = present and isinstance(group, dict) and group.get("enabled") is True\n'
             '        return AgentBootstrapResult(provider=provider,\n'
             '                                    status="configured_unverified" if present else "not_configured",\n'
             '                                    path=str(target), detail="delivery must be verified from recorded evidence")\n'
             '    except (OSError, ValueError, UnicodeError) as exc:\n'
             '        return AgentBootstrapResult(provider=provider, status="bootstrap_failed", path=str(target),\n'
             '                                    detail=type(exc).__name__)\n']]}]
