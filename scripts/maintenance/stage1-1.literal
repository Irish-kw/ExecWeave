[{'path': 'README.md',
  'before_sha256': 'fbaf19e957617f6b384f24df3d88d7052bd192f343df408fd250e8aa43c84212',
  'after_sha256': 'f90a4aba9035a5e47c42676b6e9f72114cde64079d2d8d2e5a4b6a181ff2dc1f',
  'edits': [[3286, 3297,
             'In this development branch, `live` only checks hook configuration; it never installs or rewrites it. '
             'Explicitly run `execweave hooks install antigravity` (or `claude`, `codex`, `cursor`, `opencode`) from '
             'your user-owned environment, without sudo. `execweave hooks status antigravity` checks setup without '
             'writing. Provider approval may still be required. **Configured does not mean evidence was delivered.** '
             'Missing delivery'],
            [3302, 3310,
             'incomplete observation are recorded independently of process exit.\n'
             '\n'
             'See [observation integrity and the negative example](docs/observation-integrity.md)'],
            [3315, 3374, ''],
            [3378, 3457, 'three result axes'],
            [3462, 3494, 'remaining release blockers. These changes are unreleased; version 0.8.34 on PyPI does'],
            [3499, 3586, 'contain them']]},
 {'path': 'README.zh-TW.md',
  'before_sha256': '00be33018d722982696995380b890db6a2df8844f19bb4416583867d144b354d',
