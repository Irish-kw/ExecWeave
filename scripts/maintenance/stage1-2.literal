             '                        "'],
            [13224, 13224,
             ')\n'
             '\n'
             '    def _record_observation_warnings(self, command: list[str], session: Entity) -> None:\n'
             '        from .agent_bootstrap import inspect_supported_agent, supported_agent\n'
             '        from .hook_delivery import sidecar_delivery\n'
             '\n'
             '        def warning(reason: str, **details: object) -> None:\n'
             '            self.sink.emit(RuntimeEvent.create(\n'
             '                session_id=self.session_id, event_type="observation.warning",\n'
             '                relation="HAS_OBSERVATION_WARNING", source=session,\n'
             '                target=Entity(type="observation_warning", id=f"warning:{self.session_id}:{reason}",\n'
             '                              name=reason),\n'
             '                attributes={"reason": reason, "severity": "warning", **details},\n'
             '            ))\n'
             '\n'
             '        warning("short_lived_process_loss_possible", backend=self.backend_name,\n'
             '                poll_interval_seconds=self.poll_interval, missed_process_lower_bound=None)\n'
             '        provider = supported_agent(command)\n'
             '        if provider is not None:\n'
             '            configured = inspect_supported_agent(command)\n'
             '            delivery = sidecar_delivery(os.environ.get("EXECWEAVE_SEMANTIC_SIDECAR"))\n'
             '            if delivery["state"] != "records_present":\n'
             '                warning("hook_no_evidence", provider=provider,\n'
             '                        hook_configuration_state=configured.status, delivery=delivery']]},
