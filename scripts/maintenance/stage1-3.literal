  'edits': [[207, 207, ', FileCreatedEvent, FileModifiedEvent, FileDeletedEvent'],
            [3758, 3758,
             '\n'
             '        # watchdog emits a parent DirModifiedEvent when an internal file closes.\n'
             '        # Recording that event writes the sink again, producing an infinite loop.\n'
             '        # Suppress only aggregate directory-modified hints along recorder paths;\n'
             '        # concrete user file changes and directory create/move/delete remain visible.\n'
             '        sink_path = getattr(self.sink, "path", None)\n'
             '        internal = (*self.excluded_roots, *((sink_path.resolve(),) if isinstance(sink_path, Path) else ()))\n'
             '        self._internal_parents = {parent for path in internal for parent in path.parents}'],
            [4140, 4140,
             'if event.is_directory and event.event_type == "modified" and src in self._internal_parents:\n'
             '            return\n'
             '        '],
            [4376, 4376, '\n            "writer_identity": "unknown",\n            "snapshot_state": "not_captured",'],
            [4821, 4821, '\n            '],
            [4895, 4895,
             ',\n'
             '            attributes={"path": str(target_path), "writer_identity": "unknown",\n'
             '                        "snapshot_state": "not_captured"},\n'
             '        '],
            [6717, 6717,
             'self._baseline: dict[str, tuple[int, int, int, int]] | None = None\n'
             '        self._inventory_limited = False\n'
             '        '],
            [8030, 8035, '_inventory'],
            [8045, 8045,
             'dict[str, tuple[int, int, int, int]]:\n'
             '        found: dict[str, tuple[int, int, int, int]] = {}\n'
             '        budget = 100000\n'
             '        def failed(_error: OSError) -> '],
            [8050, 8050,
             '\n'
             '            self._inventory_limited = True\n'
             '        for base, directories, files in os.walk(self.root, followlinks=False, onerror=failed):\n'
             '            directories[:] = [name for name in directories\n'
             '                              if not self.handler._excluded(str(Path(base) / name))]\n'
             '            budget -= 1\n'
             '            for name in files:\n'
             '                budget -= 1\n'
             '                if budget < 0:\n'
             '                    self._inventory_limited = True\n'
             '                    return found\n'
             '                path = Path(base) / name\n'
             '                if self.handler._excluded(str(path)):\n'
             '                    continue\n'
             '                try:\n'
             '                    info = path.lstat()\n'
             '                    found[str(path)] = (info.st_size, info.st_mtime_ns, info.st_ctime_ns, info.st_ino)\n'
             '                except OSError:\n'
             '                    self._inventory_limited = True\n'
             '            if budget < 0:\n'
             '                self._inventory_limited = True\n'
             '                break\n'
             '        return found\n'
             '\n'
             '    def start(self) -> None:\n'
             '        self._baseline = self._inventory()'],
            [9167, 9167,
             '\n'
             '        before, self._baseline = self._baseline, None\n'
             '        if before is None:\n'
             '            return\n'
             '        after = self._inventory()\n'
             '        # A final metadata difference is independent observation, not a process edge.\n'
             '        for path, signature in after.items():\n'
             '            if path not in before:\n'
             '                self.handler._emit(FileCreatedEvent(path))\n'
             '            elif before[path] != signature:\n'
             '                self.handler._emit(FileModifiedEvent(path))\n'
             '        if not self._inventory_limited:\n'
             '            for path in before.keys() - after.keys():\n'
             '                self.handler._emit(FileDeletedEvent(path))\n'
             '        if self._inventory_limited:\n'
             '            self.handler.sink.emit(RuntimeEvent.create(\n'
             '                session_id=self.handler.session_id, event_type="observation.warning",\n'
             '                relation="HAS_OBSERVATION_WARNING", source=self.handler.session_entity,\n'
             '                attributes={"reason": "filesystem_inventory_incomplete", "severity": "warning"},\n'
             '            ))']]},
