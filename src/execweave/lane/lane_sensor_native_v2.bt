// io_uring submissions are not visible to the syscall probes above (the operation is carried out by the kernel from a shared ring): record that the task used io_uring at all
tracepoint:syscalls:sys_enter_io_uring_enter { printf("{\"ev\":\"io_uring_enter\",\"ns\":%lld,\"cg\":%llu,\"pid\":%d,\"uid\":%d}\n", nsecs, cgroup, pid, uid); }

// connections other than IPv4 connect(): Unix sockets and IPv6 connect, datagrams sent to an explicit address, bind/listen/accept
tracepoint:syscalls:sys_enter_connect
{
  $sa = (struct sockaddr *)args->uservaddr;
  if ($sa->sa_family == 1) {
    $su = (struct sockaddr_un *)args->uservaddr;
    printf("{\"ev\":\"connect_unix\",\"ns\":%lld,\"cg\":%llu,\"pid\":%d,\"uid\":%d,\"path\":\"%s\"}\n", nsecs, cgroup, pid, uid, $su->sun_path);
  }
  if ($sa->sa_family == 10) {
    $s6 = (struct sockaddr_in6 *)args->uservaddr;
    printf("{\"ev\":\"connect6\",\"ns\":%lld,\"cg\":%llu,\"pid\":%d,\"uid\":%d,\"addr\":\"%s\",\"port\":%d}\n", nsecs, cgroup, pid, uid, ntop(10, $s6->sin6_addr.in6_u.u6_addr8), (($s6->sin6_port & 0xff) << 8) | ($s6->sin6_port >> 8));
  }
}
